    {
      "op": "reimport",
      "path": ".local/verification/scenario-exports/ordered-light-vanilla.png"
    },
    {
      "op": "assert",
      "children": {
        "keys": [
          622,
          962,
          626,
          1130,
          794,
          1298,
          1540,
          113,
          115
        ]
      }
