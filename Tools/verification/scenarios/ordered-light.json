    {
      "op": "reimport",
      "path": ".local/verification/scenario-exports/ordered-light-source.png"
    },
    {
      "op": "assert",
      "children": {
        "keys": [
          622,
          65,
          962,
          626,
          1130,
          794,
          1298,
          1540,
          113,
          114
        ]
      }
    },
    {
      "op": "delete",
