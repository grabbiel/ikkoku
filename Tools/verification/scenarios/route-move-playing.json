    {"op": "assertRejected", "route": {"key": 0, "from": "before-drag"}, "errorContains": "point 2 differs"},
    {"op": "assert", "route": {"key": 0, "from": "moved", "edited": false, "points": 4, "point": [{"index": 1, "position": [1.2, 0.8, -0.6]}]}, "routePlaying": {"key": 0, "playing": true}, "routeLines": 2}
